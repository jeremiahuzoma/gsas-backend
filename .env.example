# ---------------------------------------------------------------------------
# Watts Up Meter API — copy to backend/.env and fill in.
# Never commit .env. Secrets below are read only by the backend; nothing here
# is ever sent to the browser.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000

# PostgreSQL 13+ (docker compose up -d db gives you this one).
DATABASE_URL=postgresql://watts:watts@localhost:5432/watts_up_meter

# JWT signing key — at least 32 random characters in production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# Browser origins allowed by CORS (comma-separated).
FRONTEND_URL=http://localhost:5173

# --- Africa's Talking --------------------------------------------------------
# Sandbox: username is literally "sandbox"; API key from the sandbox app's
# Settings > API Key. Live: your live app's username and key, and set
# AFRICASTALKING_ENVIRONMENT=production.
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
AFRICASTALKING_ENVIRONMENT=sandbox
# Approved alphanumeric sender ID or short code (leave empty in sandbox).
AFRICASTALKING_SMS_SENDER_ID=
# USSD code assigned to your channel, e.g. *384*1100# (shown in the UI, never invented).
AFRICASTALKING_USSD_SERVICE_CODE=
# Optional webhook hardening. When set, USSD and delivery-report callbacks must
# carry an HMAC-SHA256 signature header or ?token=<this value> in the URL.
AFRICASTALKING_WEBHOOK_SECRET=
# Shared secret for POST /api/webhooks/sms/retry (falls back to the webhook secret).
SMS_RETRY_SECRET=

# --- Simulation ---------------------------------------------------------------
METER_READING_INTERVAL_MS=5000
SIMULATION_TICK_MS=1000
SSE_MAX_STREAM_MS=540000

# --- Background jobs / limits -------------------------------------------------
# Run the SMS retry worker in-process every N ms (0 = only via the endpoint/admin).
SMS_RETRY_INTERVAL_MS=60000
AUTH_RATE_LIMIT_PER_MINUTE=10

# --- One-off import from the old Supabase project (see README) ----------------
# SOURCE_DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
